<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exam Preparation Manager</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>📚 Exam Preparation Manager</h1>
        <p>Organize your studies and track your progress</p>
    </header>

    <div class="container">

        <section class="cards">
            <div class="card">
                <h3>Subjects</h3>
                <p id="subjectCount">0</p>
            </div>

            <div class="card">
                <h3>Completed</h3>
                <p id="completedCount">0</p>
            </div>

            <div class="card">
                <h3>Pending</h3>
                <p id="pendingCount">0</p>
            </div>
        </section>

        <section class="box">
            <h2>Add Subject</h2>

            <input type="text" id="subjectInput"
                   placeholder="Enter subject name">

            <button onclick="addSubject()">Add Subject</button>

            <ul id="subjectList"></ul>
        </section>

        <section class="box">
            <h2>📝 Study Tasks</h2>

            <input type="text" id="taskInput"
                   placeholder="Enter study task">

            <button onclick="addTask()">Add Task</button>

            <ul id="taskList"></ul>
        </section>

        <section class="box">
            <h2>📊 Overall Progress</h2>

            <div class="progress">
                <div id="progressBar"></div>
            </div>

            <p id="progressText">0% Completed</p>
        </section>

    </div>

    <script src="script.js"></script>

</body>
</html>